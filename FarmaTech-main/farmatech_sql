CREATE DATABASE farmatech;
USE farmatech;

CREATE TABLE tbl_usuarios (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    login_usuario VARCHAR(50) NOT NULL UNIQUE,
    senha_usuario VARCHAR(50) NOT NULL,
    tipo_usuario ENUM('admin', 'cliente') NOT NULL
);

CREATE TABLE tbl_produtos (
    id_produto INT AUTO_INCREMENT PRIMARY KEY,
    nome_produto VARCHAR(100) NOT NULL,
    preco_produto DECIMAL(10,2) CHECK (preco_produto >= 0),
    quantidade_produto INT CHECK (quantidade_produto >= 0)
);

CREATE TABLE tbl_vendas (
    id_venda INT AUTO_INCREMENT PRIMARY KEY,
    total_venda DECIMAL(10,2),
    forma_pagamento VARCHAR(50),
	data_venda DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE tbl_vendas_produtos (
	id_venda_produto INT AUTO_INCREMENT PRIMARY KEY,
    id_venda INT NOT NULL,
    id_produto INT NOT NULL,
    quantidade_produto INT NOT NULL,
    subtotal_produto DECIMAL(10,2) NOT NULL,
    FOREIGN KEY (id_venda)
    REFERENCES tbl_vendas(id_venda),
    FOREIGN KEY (id_produto)
    REFERENCES tbl_produtos(id_produto)
);

